; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Doodle Tank"
config/version="0.0.1"
run/main_scene="res://scenes/opening/opening.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="uid://dntm7xvd0fpoh"

[autoload]

Global="*uid://b2hho3yg76d65"
SceneLoader="*uid://cpehcs7n5c62p"

[clean_copy_examples]

examples_paths=Array[String](["res://addons/maaacks_game_template/examples/", "res://addons/maaacks_scene_loader/examples/"])
replace_strings=Dictionary[String, String]({
"StateExample": "State"
})
copy_path="res://"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/maaacks_game_template/plugin.cfg", "res://addons/maaacks_scene_loader/plugin.cfg", "res://addons/plugin_updater/plugin.cfg")

[gui]

theme/custom="res://resources/themes/steal_this_theme.tres"

