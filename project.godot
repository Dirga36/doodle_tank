[internationalization]

locale/translations=PackedStringArray("res://addons/maaacks_game_template/base/translations/menus_translations.en.translation", "res://addons/maaacks_game_template/base/translations/menus_translations.fr.translation")

[layer_names]

2d_physics/layer_1="World and Ground Enemy"
2d_physics/layer_2="Player"
2d_physics/layer_3="Air Enemy"
2d_physics/layer_4="Projectiles"

[maaacks_game_template]

disable_install_wizard=true
main_menu_scene_path="res://scenes/menus/main_menu/main_menu.tscn"
game_scene_path="res://scenes/game/game.tscn"
ending_scene_path="res://scenes/end_credits/end_credits.tscn"
copy_path="res://"

[maaacks_scene_loader]

loading_scene_path="res://scenes/loading_screens/loading_screen.tscn"

[physics]

3d/physics_engine="Jolt Physics"

[plugin_updater]

plugins={
"res://addons/maaacks_game_template/": "https://github.com/Maaack/Godot-Game-Template",
"res://addons/maaacks_scene_loader/": "https://github.com/Maaack/Godot-Scene-Loader",
"res://addons/plugin_updater/": "https://github.com/Maaack/Godot-Plugin-Updater"
}

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
